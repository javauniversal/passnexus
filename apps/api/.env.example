DATABASE_URL="postgresql://passnexus:change-this-local-password@localhost:5432/passnexus?schema=public"
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
# Optional comma-separated compatibility origins accepted by CORS.
# WEB_ORIGINS=https://legacy.example.com
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Generate with: openssl rand -base64 32. Required to encrypt persisted TOTP secrets.
TOTP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
RESEND_API_KEY=replace-with-a-restricted-resend-api-key
EMAIL_FROM=PassNexus <no-reply@mail.passnexus.fiiss.com>
EMAIL_REPLY_TO=support@example.com
# Optional one-time bootstrap for a new database. Remove the password after first login.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=PassNexus Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-password